[
  {
    "id": "security-alert",
    "execute-command": "/hooks/notify.sh",
    "command-working-directory": "/hooks",
    "response-message": "Alert received",
    "response-headers": [
      {
        "name": "Access-Control-Allow-Origin",
        "value": "*"
      }
    ],
    "pass-arguments-to-command": [],
    "pass-environment-to-command": [
      {
        "envname": "PAYLOAD",
        "source": "entire-payload"
      }
    ],
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "localobserve",
        "parameter": {
          "source": "header",
          "name": "X-Alert-Source"
        }
      }
    }
  },
  {
    "id": "security-alert-open",
    "execute-command": "/hooks/notify.sh",
    "command-working-directory": "/hooks",
    "response-message": "Alert received",
    "response-headers": [
      {
        "name": "Access-Control-Allow-Origin",
        "value": "*"
      }
    ],
    "pass-arguments-to-command": [],
    "pass-environment-to-command": [
      {
        "envname": "PAYLOAD",
        "source": "entire-payload"
      }
    ]
  },
  {
    "id": "test-alert",
    "execute-command": "/hooks/notify.sh",
    "command-working-directory": "/hooks",
    "response-message": "Test alert received",
    "response-headers": [
      {
        "name": "Access-Control-Allow-Origin",
        "value": "*"
      }
    ],
    "pass-arguments-to-command": [],
    "pass-environment-to-command": [
      {
        "envname": "PAYLOAD",
        "source": "entire-payload"
      }
    ]
  }
]
